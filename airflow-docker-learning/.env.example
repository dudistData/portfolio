# This file contains environment variables that Docker Compose uses.
# Copy this file to '.env' before running docker compose.
# E.g., cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)

# The User ID (UID) of the host user running docker.
# It helps ensure files created by Docker have the right permissions on your host.
# For Linux/Mac, you can find your UID by typing `id -u` in the terminal.
# For Windows with Docker Desktop, 50000 is a safe default.
AIRFLOW_UID=50000

# The credentials to log in to the Airflow UI (localhost:8080)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
